# Due starter template configuration.
# On Dailey OS most of this is provided for you; local development fills it in here.

NODE_ENV=development
PORT=3000

# Database. Dailey OS injects DATABASE_URL when your project has a database
# enabled. For local development you can use the individual variables instead.
# DATABASE_URL=mysql://user:password@localhost:3306/due
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=due

# Storage. Dailey OS injects the S3_* variables when project storage is
# enabled. Attachments are disabled gracefully when these are empty.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
STORAGE_PREFIX=due

# Dailey Core auth. Run the auth enable step for your project, then set
# DAILEY_APP_ID to the client id it returns (your project slug).
DAILEY_AUTH_URL=https://core.dailey.cloud
DAILEY_APP_ID=

# Optional hardening once you have the values:
# CORE_EXPECTED_APP_ID=<core app uuid from the auth enable response>

# Local development only. Never enable in production (the server refuses).
DEV_BYPASS_AUTH=false
